# Local development environment for the Cloud Functions.
#
# Copy to `.env` (which is gitignored) and fill in real values. The Firebase
# emulator reads this automatically; deployed functions ignore it and use
# Secret Manager instead, so a key here never leaves your machine.
#
#   cp .env.example .env

# Required to send mail. Get yours at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Resend only permits onboarding@resend.dev as the sender for
# your own inbox until you verify a domain, so real applicant mail will be
# rejected until this points at a verified domain.
CRP_EMAIL_FROM=CRP Tester Program <testing@crp.company>

# Optional overrides. The defaults match the live site, so you normally leave
# these alone.
# CRP_EMAIL_LOGO_URL=https://i.postimg.cc/K8zf4q4q/CRPlogo.png
# CRP_EMAIL_HERO_URL=https://www.image2url.com/r2/default/images/1776869274976-74e932ff-18d5-462e-885b-c6ed42d42bcf.png
# CRP_SITE_URL=https://crp-company.github.io/CRP-early-access/
# CRP_PRIVACY_URL=https://crp-company.github.io/CRP-Privacy-policy/

# Google Wallet pass signing key, needed only for issueWalletPass.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
