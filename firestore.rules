rules_version = '2';

// CRP early-access — Firestore security rules.
//
// Design goals
//  1. `requests` and `testers` are separate collections with separate lifecycles.
//  2. Anyone may CREATE a request, but nobody but an admin may read, edit or
//     delete one. Requests are append-only from the public's point of view.
//  3. `testers` is written ONLY by Cloud Functions via the Admin SDK, which
//     bypasses these rules. There is deliberately no client-side create/update
//     path, so a tester record can never be forged or flipped `active` by a
//     visitor. `allow write: if false;` is the enforcement point.
//
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    // Staff identity comes from a custom claim on the Firebase Auth token,
    // not from a field in Firestore (which any client could self-write).
    // Set it with: node scripts/set-admin-claim.js <uid|email>
    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    // A signed-in tester may read exactly their own record. Matching on the
    // verified token email means they cannot widen this to other testers.
    function isSelf(email) {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == email;
    }

    // Every field the public form is allowed to submit. Anything else in the
    // document fails hasOnly() and the write is rejected outright.
    function validNewRequest(data) {
      return data.keys().hasOnly([
          'name',
          'email',
          'consent',
          'experienceCategory',
          'status',
          'source',
          'createdAt',
          'userAgent',
          'website'
        ])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 80
        && data.email is string
        && data.email.size() <= 254
        && data.email.matches('^[^@]+@[^@]+\\.[^@\\.]+$')
        && data.experienceCategory in ['developer', 'everyday_user', 'new_to_technology']
        // consent is required by the form's checkbox; store it as proof.
        && data.consent == true
        // A visitor may never create a pre-approved request.
        && data.status == 'pending'
        && data.source == 'early-access-site'
        // Honeypot: the field is hidden from humans, so a real submission
        // always leaves it empty. A filled value means a bot.
        && data.website == ''
        // serverTimestamp() resolves to the commit time, so this both blocks
        // spoofed dates and pins ordering to the server clock.
        && data.createdAt == request.time
        && data.userAgent is string
        && data.userAgent.size() <= 300;
    }

    // -------------------------------------------------------------- requests
    // Public intake queue. Anonymous reads are blocked: the collection holds
    // other people's email addresses.
    match /requests/{requestId} {
      allow create: if validNewRequest(request.resource.data);
      allow read, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // A public "did I already apply" marker, so a repeat visitor is told they
    // are already queued instead of silently creating a second row.
    //
    // The document id is a SHA-256 hash of the lowercased email, and the body
    // holds only a request id and a timestamp — no name, no email address. So
    // `get` here leaks no personal data; `list` stays denied so the collection
    // cannot be enumerated.
    match /requestEmails/{emailKey} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['requestId', 'createdAt'])
        && request.resource.data.requestId is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ----------------------------------------------------------- tester index
    // A deterministic email -> testerId pointer, so a signed-in tester can find
    // their own record without being able to `list` the roster.
    //
    // `allow list: if isAdmin()` on `testers` is what makes this necessary: a
    // tester may `get` their document but cannot query for it, because a query
    // they could shape would also let them read anyone else's. Mirrors the
    // existing requestEmails marker exactly.
    //
    // The body holds only the tester document id — no name, no address — so this
    // `get` leaks no personal data. `list` stays denied so the index cannot be
    // enumerated and turned back into an email directory.
    match /testerIndex/{emailKey} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if false;
    }

    // ----------------------------------------------------------------- users
    // The roster. `tester` is a nested MAP on the user document rather than a
    // document of its own, so a tester is identified by the Auth uid that owns
    // it — not by a `t_...` key.
    //
    // Two things this collection must never allow:
    //
    //   1. A client writing `tester` at all. The tester record is the whole
    //      programme's source of truth for who is active, and it is written
    //      exclusively by the Cloudflare Worker using a service account, which
    //      bypasses these rules. If `tester` were client-writable, any tester
    //      could flip their own `active` flag or hand themselves a number.
    //   2. A client reading another person's `tester` map, or enumerating the
    //      collection to harvest emails and activity counts.
    //
    // A signed-in user may read and update their OWN document, but only the
    // fields they own. The `diff()` check is what enforces that: it compares
    // before and after and fails if any field the user does not own appears,
    // is removed, or changes. Without it, a self-update could quietly blank out
    // `tester` or rewrite `testerHistory`.
    match /users/{userId} {
      // The user themself, or staff. A tester's own `tester` map is included,
      // which is how the app renders "you are tester #4" in their profile.
      allow get: if isAdmin() || isSelfUser(userId);
      // No list for ordinary users: the collection holds every account's email.
      allow list: if isAdmin();

      // Only a self-service create, and never one that sneaks in a tester map.
      allow create: if isSelfUser(userId)
        && !request.resource.data.keys().hasAny(['tester', 'testerHistory']);

      // Self-service update, restricted to the fields this app owns. Staff
      // writes go through the Worker and bypass these rules entirely.
      allow update: if isAdmin() || (
        isSelfUser(userId)
        // Nothing the tester programme owns may change.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'lastLogin', 'friends', 'friendRequests',
                       'profileImage', 'settings'])
      );
      allow delete: if false;
    }

    // A tester's own account document, written by the CRP Focus app on sign-up.
    //
    // Scoped to the owner so one user cannot read or rewrite another's account.
    // `get` rather than `list`: the app only ever addresses its own document by
    // id, and a `list` grant here would be a lie — Firestore evaluates the rule
    // per document, so a collection query would still be refused for every row
    // that is not the caller's.
    match /users/{userId} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'uid']);
      // Update is allowed to the owner but cannot change identity: `email` and
      // `uid` must match what was there before, so a session cannot be used to
      // repoint an account at another address. displayName stays editable, which
      // is the only field the app ever changes after sign-up.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------- tester feedback
    // What testers ask for: one document per submission, owned by its tester.
    //
    // Nested under the tester rather than in a top-level collection, because the
    // path itself carries the ownership check — `ownsTester()` below can confirm
    // the caller owns `testerId` without trusting anything in the request body. A
    // flat collection would have to trust a self-declared testerId field, which
    // is exactly the thing a client controls.
    match /testers/{testerId}/feedback/{feedbackId} {
      allow create: if ownsTester(testerId)
        && validNewFeedback(request.resource.data)
        // The author and the owner must be the same verified address, so a
        // tester cannot file feedback under someone else's number.
        && request.resource.data.email == request.auth.token.email;
      allow read: if isAdmin() || ownsTester(testerId);
      // No update or delete from a client: feedback is part of the program's
      // record of what was asked for, so a tester cannot edit a submission after
      // the fact. Staff triage goes through the Worker, which re-checks the claim.
      allow update, delete: if isAdmin();
    }

    // Monthly activity log (comments / reviews per month), used to decide who
    // stays active. Keyed by uid now that the tester lives on the user document.
    match /users/{userId}/activity/{period} {
      allow read: if isAdmin() || isSelfUser(userId);
      allow write: if false;
    }

    // ---------------------------------------------------------------- meta
    // Internal counters, e.g. meta/testerCounter which hands out sequential
    // tester numbers. Readable by staff so the dashboard can show what the
    // next number will be; written only by Cloud Functions, since the counter
    // is allocated inside a transaction and must never be set by a client.
    match /meta/{metaId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------------ audit trail
    // Append-only record of every privileged action, written by Cloud
    // Functions. No client write path at all.
    match /audit/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
